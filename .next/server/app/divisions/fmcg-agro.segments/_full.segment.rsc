2:T33d2,{"@context":"https://schema.org","@type":"Corporation","name":"EKCHAKRA International Pvt LTD","alternateName":["EKCHAKRA Group","Ekchakra International","PAA Solar Group"],"description":"Ekachakra literally means \"one wheel\" (Eka = One, Chakra = Wheel) in Sanskrit. EKCHAKRA operates on this unified principle, providing an expansive 360-degree multi-sector ecosystem under one singular umbrella.","url":"https://ekchakra.com","logo":"https://ekchakra.com/logo.png","email":"contact@ekchakra.com","telephone":"+91 (0) 11 4987 6543","address":{"@type":"PostalAddress","streetAddress":"Sector 62, Institutional Area","addressLocality":"Noida","addressRegion":"NCR / Uttar Pradesh","postalCode":"201309","addressCountry":"IN"},"award":"AN ISO 9001:2015 CERTIFIED COMPANY","founder":{"@type":"Person","name":"Board of Directors, Ekchakra Group"},"employee":[{"@type":"Person","name":"Mr. Pandey","jobTitle":"Director & Group Director","worksFor":{"@type":"Organization","name":"PAA SOLAR / EKCHAKRA EXPORT"}},{"@type":"Person","name":"Punam","jobTitle":"Director","worksFor":{"@type":"Organization","name":"SHILP CRAFT"}},{"@type":"Person","name":"Ritesh","jobTitle":"Director","worksFor":{"@type":"Organization","name":"RJ TRAVEL JUNCTION"}},{"@type":"Person","name":"Aastha","jobTitle":"Director","worksFor":{"@type":"Organization","name":"DELIGHT APPAREL"}},{"@type":"Person","name":"Aashray (BA LLB)","jobTitle":"Director & Legal Head","worksFor":{"@type":"Organization","name":"AAP KA HAQ"}},{"@type":"Person","name":"Priyanka","jobTitle":"Group HR Head","worksFor":{"@type":"Organization","name":"EKCHAKRA GROUP"}},{"@type":"Person","name":"Mr. Dinesh","jobTitle":"Group Financial Advisor","worksFor":{"@type":"Organization","name":"EKCHAKRA GROUP"}},{"@type":"Person","name":"Mr. Bhardwaj","jobTitle":"Group Marketing Manager","worksFor":{"@type":"Organization","name":"EKCHAKRA GROUP"}}],"subOrganization":[{"@type":"Organization","name":"PAA SOLAR / EKCHAKRA SOLAR","description":"Specializes in Tier-1 TOPCon N-type solar panels (500Wp-640Wp+), Grid-Tie, Hybrid, and Off-Grid inverters, and long-life LiFePO4 energy storage solutions for utility, commercial, and residential projects.","knowsAbout":["Solar EPC","TOPCon Module Supply","Hybrid Energy Storage","Turnkey Grid-Tie Projects"]},{"@type":"Organization","name":"EKCHAKRA FMCG & AGRO EXPORT","description":"Premier export house processing Indian Basmati & Non-Basmati rice, sortex-grade Makhana (fox nuts), whole & ground spices (Jeera, Garlic powder, Red Chilli, Garam Masala), Moringa superfood, Guar Gum, and pure Desi Ghee.","knowsAbout":["Custom Milling & Sorting","Airtight Vacuum Packaging","APEDA/FSSAI Certified Exports"]},{"@type":"Organization","name":"SHILP CRAFT","description":"Empowering traditional Indian artisans through sustainable craft production. Selling authentic wooden, brass, and textile handicrafts across Amazon.in, Amazon.com, Bazar.com, and international boutique partners.","knowsAbout":["Handmade Brass & Wood Decor","Artisan Fair-Trade Sourcing","Custom Corporate Gifting"]},{"@type":"Organization","name":"RJ TRAVEL JUNCTION","description":"Comprehensive travel management agency orchestrating corporate MICE tours, inbound Indian heritage expeditions, bespoke outbound holiday itineraries, flights, and visa facilitation.","knowsAbout":["Custom Inbound/Outbound Packages","Corporate MICE & Conferences","Luxury Hotel & Flight Ticketing"]},{"@type":"Organization","name":"DELIGHT APPAREL","description":"Modern garment production unit creating premium casual wear, ethnic apparel, and uniform lines with global delivery capability via Amazon, Flipkart, and international apparel distributors.","knowsAbout":["OEM Garment Manufacturing","Private Label Apparel","E-Commerce Fashion Distribution"]},{"@type":"Organization","name":"AAP KA HAQ","description":"Professional legal advisory group delivering swift, dependable counsel on corporate law, cross-border commercial contracts, intellectual property, arbitration, and domestic dispute resolution.","knowsAbout":["Export Contract Vetting","IP & Trademark Filing","Dispute Resolution & Advisory"]},{"@type":"Organization","name":"B K METAL","description":"Precision manufacturer of high-tensile galvanized steel mounting structures for solar farms, industrial shed frameworks, transmission towers, and custom infrastructure fabrication.","knowsAbout":["Solar Module Mounting Structures (MMS)","Hot-Dip Galvanizing","Custom CNC Steel Fabrication"]}],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Ekchakra Global Export Catalog","itemListElement":[{"@type":"OfferCatalog","name":"TOPCon N-Type Solar PV Modules (500Wp – 640Wp+)","position":1,"itemListElement":{"@type":"Product","name":"TOPCon N-Type Solar PV Modules (500Wp – 640Wp+)","description":"Next-generation N-Type Tunnel Oxide Passivated Contact solar panels delivering up to 23.32% efficiency and 30-year warranty.","category":"solar","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"High-Efficiency Grid-Tie Solar Inverter","position":2,"itemListElement":{"@type":"Product","name":"High-Efficiency Grid-Tie Solar Inverter","description":"Transformerless solar inverters with 98%+ conversion efficiency, multi-MPPT tracking, and net metering synchronization.","category":"solar","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Smart All-in-One Hybrid Solar Inverter (3kW – 50kW)","position":3,"itemListElement":{"@type":"Product","name":"Smart All-in-One Hybrid Solar Inverter (3kW – 50kW)","description":"Integrated solar inverter and battery charge management unit with sub-10ms UPS switching and smart peak shaving.","category":"solar","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Heavy-Duty Pure Sine Wave Off-Grid Inverter","position":4,"itemListElement":{"@type":"Product","name":"Heavy-Duty Pure Sine Wave Off-Grid Inverter","description":"Standalone solar inverter systems (1kW to 10kW+) engineered for remote sites, farms, and independent micro-grids.","category":"solar","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"LiFePO4 Lithium Iron Phosphate Energy Storage (48V / 100Ah – 200Ah)","position":5,"itemListElement":{"@type":"Product","name":"LiFePO4 Lithium Iron Phosphate Energy Storage (48V / 100Ah – 200Ah)","description":"Ultra-safe, long-cycle life lithium storage blocks delivering 5,000+ cycles at 80% DoD and 95% round-trip efficiency.","category":"solar","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Premium Indian Basmati & Non-Basmati Rice","position":6,"itemListElement":{"@type":"Product","name":"Premium Indian Basmati & Non-Basmati Rice","description":"Aromatic extra-long grain 1121, Traditional, Pusa Basmati, and Sona Masoori/PR11 from Punjab, West Bengal, and Andhra Pradesh.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Sortex Indian Makhana (Fox Nuts / Gorgon Nut)","position":7,"itemListElement":{"@type":"Product","name":"Sortex Indian Makhana (Fox Nuts / Gorgon Nut)","description":"Hand-picked organic raw, puffed (Phool) Makhana (4+, 5+, 6+ Suta) and gourmet roasted flavored snacks.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Machine-Cleaned Jeera (Cumin Seeds)","position":8,"itemListElement":{"@type":"Product","name":"Machine-Cleaned Jeera (Cumin Seeds)","description":"Aromatic cumin seeds from Gujarat and Rajasthan with high essential oil content and 99.5% sortex purity.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Dehydrated Lahsun (Garlic) Powder","position":9,"itemListElement":{"@type":"Product","name":"Dehydrated Lahsun (Garlic) Powder","description":"Fine-mesh dehydrated garlic powder prepared by low-temperature dehydration and micro-pulverization.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Pure Red Mircha Powder (Chilli Powder)","position":10,"itemListElement":{"@type":"Product","name":"Pure Red Mircha Powder (Chilli Powder)","description":"Authentic Indian red chilli powder available in Guntur, Byadgi, Mathania, and bright Kashmiri varieties.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Artisanal Royal Garam Masala Powder","position":11,"itemListElement":{"@type":"Product","name":"Artisanal Royal Garam Masala Powder","description":"Signature spice blend of cumin, coriander, green cardamom, cloves, cinnamon, black peppercorns, and mace.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Organic Moringa (Drumstick Leaf) Powder","position":12,"itemListElement":{"@type":"Product","name":"Organic Moringa (Drumstick Leaf) Powder","description":"Nutrient-dense green superfood powder prepared from shade-dried organic Moringa oleifera leaves.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"High-Viscosity Guar Gum (Gawar Gum) Powder","position":13,"itemListElement":{"@type":"Product","name":"High-Viscosity Guar Gum (Gawar Gum) Powder","description":"Natural water-soluble galactomannan polysaccharide thickener, binder, and stabilizer from guar bean endosperm.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Traditional Pure Desi Ghee (Clarified Butter)","position":14,"itemListElement":{"@type":"Product","name":"Traditional Pure Desi Ghee (Clarified Butter)","description":"Traditional Bilona & simmered cow clarified butter with 99.5% pure fat, nutty aroma, and high smoke point.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Organic Cow Dung Fertilizer & Biomass Fuel Products","position":15,"itemListElement":{"@type":"Product","name":"Organic Cow Dung Fertilizer & Biomass Fuel Products","description":"Eco-friendly composted organic fertilizer (3-2-1 NPK), biogas methane substrate, and dried fuel cakes.","category":"fmcg","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Artisan Heritage Brass & Wooden Handicrafts","position":16,"itemListElement":{"@type":"Product","name":"Artisan Heritage Brass & Wooden Handicrafts","description":"Hand-carved wooden artifacts, brass figurines, and festive home decor sourced from master Indian artisans.","category":"craft","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Delight Fashion & Casual Wear Apparel","position":17,"itemListElement":{"@type":"Product","name":"Delight Fashion & Casual Wear Apparel","description":"Export-grade cotton casuals, ethnic ensembles, and private-label apparel manufacturing.","category":"apparel","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}},{"@type":"OfferCatalog","name":"Hot-Dip Galvanized Solar Mounting & Industrial Steel Structures","position":18,"itemListElement":{"@type":"Product","name":"Hot-Dip Galvanized Solar Mounting & Industrial Steel Structures","description":"Corrosion-resistant galvanized steel structures engineered for solar farms, industrial sheds, and heavy infrastructure.","category":"metal","offers":{"@type":"AggregateOffer","priceCurrency":"USD","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}}]}}9:X
