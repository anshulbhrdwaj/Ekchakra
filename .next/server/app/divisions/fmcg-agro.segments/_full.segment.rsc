3:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"EKCHAKRA International Pvt LTD\",\"url\":\"https://ekchakra.com\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://ekchakra.com/?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}}"}}]
d:T95d,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the corporate structure and background of EKCHAKRA International Pvt LTD?","acceptedAnswer":{"@type":"Answer","text":"Ekchakra (from Sanskrit \"Eka\" meaning one and \"Chakra\" meaning wheel) operates as a multi-sector international conglomerate. We provide diversified solutions across Solar Renewable Energy, FMCG & Agro Exports, Artisanal Handicrafts (Shilp Craft), Tour & Travel (RJ Travel Junction), Fashion Apparel (Delight Apparel), Legal Advisory (AAP KA HAQ), and Galvanized Metals (BK Metal)."}},{"@type":"Question","name":"What are the technical advantages of Ekchakra’s TOPCon Solar Panels?","acceptedAnswer":{"@type":"Answer","text":"Our TOPCon (Tunnel Oxide Passivated Contact) N-type solar modules deliver up to 23.32% conversion efficiency, ultra-low first-year degradation (≤1%), minimal annual drop (0.4%), bifacial dual-glass light harvesting, superior hot-climate thermal tolerance, and are backed by a 30-year linear performance warranty."}},{"@type":"Question","name":"Which international certifications does Ekchakra hold for export consignments?","acceptedAnswer":{"@type":"Answer","text":"Ekchakra holds ISO 9001:2015 Quality Management certification, Government of India Import Export Code (IEC), FIEO export membership, MSME/Udyam credentials, CIN incorporation, GST tax clearance, and APEDA & FSSAI food safety accreditation."}},{"@type":"Question","name":"What is the Minimum Order Quantity (MOQ) and packaging standard for FMCG & Spices?","acceptedAnswer":{"@type":"Answer","text":"For agro commodities like Basmati Rice, Spices (Jeera, Red Chilli, Garam Masala), and Makhana, we provide flexible MOQs ranging from LCL (Less than Container Load) for initial trial batches up to full 20ft and 40ft FCL container loads. Packaging options include 50g-1000g retail foil pouches, vacuum-sealed bags, 25kg/50kg PP bags, and custom private labeling."}},{"@type":"Question","name":"How can international buyers request a Request For Quotation (RFQ) or FOB/CIF pricing?","acceptedAnswer":{"@type":"Answer","text":"You can use our interactive RFQ engine on this website, email contact@ekchakra.com, or message our global export desk via WhatsApp. We provide prompt CIF, FOB, and DDP quotes complete with HS Codes, phytosanitary certifications, and shipping schedules."}}]}4:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}]
